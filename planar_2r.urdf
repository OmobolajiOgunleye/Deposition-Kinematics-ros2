<?xml version="1.0"?>
<!-- Planar 2R deposition cell on a lifting Z column. Units: metres and radians.
     Link lengths match deposition_kinematics_ros2/trajectory.py (ARM_2R). Change both together.
     The tool frame (tool0) is the tool tip at the height of the Z axis, so tool0 z equals the toolpath z. -->
<robot name="planar_2r_deposition_cell">
  <material name="steel"><color rgba="0.62 0.65 0.70 1"/></material>
  <material name="dark"><color rgba="0.22 0.24 0.27 1"/></material>
  <material name="plate"><color rgba="0.40 0.40 0.44 1"/></material>
  <material name="torch"><color rgba="1.0 0.45 0.05 1"/></material>

  <link name="world"/>

  <!-- Build plate under the part (top surface at z = 0, centred on the part at x = 0.24 m) -->
  <link name="build_plate">
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.010"/></geometry>
      <material name="plate"/>
    </visual>
  </link>
  <joint name="world_to_build_plate" type="fixed">
    <parent link="world"/><child link="build_plate"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Lifting column (fixed part) -->
  <link name="column">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.26"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="world_to_column" type="fixed">
    <parent link="world"/><child link="column"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- Z axis: carriage that moves up one layer height per layer (prismatic, metres) -->
  <link name="carriage">
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.024"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <joint name="z_lift" type="prismatic">
    <parent link="column"/><child link="carriage"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.20" effort="100" velocity="0.05"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0.1000 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2000 0.016 0.010"/></geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.014"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="joint1" type="continuous">
    <parent link="carriage"/><child link="link1"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.0750 0 0" rpy="0 0 0"/>
      <geometry><box size="0.1500 0.016 0.010"/></geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.014"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="joint2" type="continuous">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.2000 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Torch: hangs from the end of the last link down to the tool plane -->
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.0150" rpy="0 0 0"/>
      <geometry><cylinder radius="0.005" length="0.0300"/></geometry>
      <material name="torch"/>
    </visual>
  </link>
  <joint name="tool_mount" type="fixed">
    <parent link="link2"/><child link="tool0"/>
    <origin xyz="0.1500 0 -0.03" rpy="0 0 0"/>
  </joint>
</robot>
